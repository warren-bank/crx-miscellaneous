{
  "manifest_version": 2,
  "name": "chrome.windows.getAll-polyfill",
  "version": "1.0.0",
  "description": "Polyfill the API 'chrome.windows.getAll' using the API 'chrome.tabs.query'",
  "background": {
    "scripts": [
      "chrome.windows.polyfill.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [{
    "matches": ["*://example.com/chrome.windows.getAll-polyfill"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "permissions": ["tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "chrome.windows.getAll-polyfill@warren-bank.github.io"
    }
  }
}
